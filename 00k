@echo off
setlocal enabledelayedexpansion

:: 检查管理员权限
fltmc >nul 2>&1 || (echo 请以管理员身份运行此脚本！ & pause >nul & exit /b 1)

:: 窗口设置
mode con cols=120 lines=30
title Windows个性化工具 v1.0

:: 颜色定义
set "color_info=0B"
set "color_warn=0E"
set "color_error=0C"
set "color_success=0A"
set "color_default=07"

:: 主菜单
:mainMenu
cls
echo.
echo ==============================================
echo               Windows个性化工具
echo ==============================================
echo.
echo [1] 管理更新
echo [2] 注册表工具
echo [3] 高级选项
echo [4] 应用管理
echo [5] 关于
echo [6] 退出
echo.
set /p "choice=请选择操作 [1-6]: "

:: 菜单跳转
if "%choice%"=="1" goto menuUpdates
if "%choice%"=="2" goto menuRegistry
if "%choice%"=="3" goto menuAdvanced
if "%choice%"=="4" goto menuApps
if "%choice%"=="5" goto menuAbout
if "%choice%"=="6" exit /b 0

:: 无效选择
echo.
echo 无效的选择，请重试！
ping -n 2 127.0.0.1 >nul
goto mainMenu

:: 更新管理子菜单
:menuUpdates
cls
echo.
echo ==============================================
echo               更新管理
echo ==============================================
echo.
echo [1] 禁用自动更新
echo [2] 启用自动更新
echo [3] 清理更新缓存
echo [4] 检查更新状态
echo [5] 返回主菜单
echo.
set /p "choice=请选择操作 [1-5]: "

if "%choice%"=="1" goto disableUpdates
if "%choice%"=="2" goto enableUpdates
if "%choice%"=="3" goto cleanUpdateCache
if "%choice%"=="4" goto checkUpdateStatus
if "%choice%"=="5" goto mainMenu

echo.
echo 无效的选择，请重试！
ping -n 2 127.0.0.1 >nul
goto menuUpdates

:: 注册表工具子菜单
:menuRegistry
cls
echo.
echo ==============================================
echo               注册表工具
echo ==============================================
echo.
echo [1] 备份注册表
echo [2] 恢复注册表
echo [3] 清理无效注册表项
echo [4] 返回主菜单
echo.
set /p "choice=请选择操作 [1-4]: "

if "%choice%"=="1" goto backupRegistry
if "%choice%"=="2" goto restoreRegistry
if "%choice%"=="3" goto cleanRegistry
if "%choice%"=="4" goto mainMenu

echo.
echo 无效的选择，请重试！
ping -n 2 127.0.0.1 >nul
goto menuRegistry

:: 这里省略其他子菜单和功能实现部分...
:: 保持原有功能代码不变，仅修改菜单文本

:menuAbout
cls
echo.
echo ==============================================
echo               关于
echo ==============================================
echo.
echo Windows个性化工具 v1.0
echo 用于系统优化、更新管理和个性化配置
echo 作者: 未知
echo 注意：使用前请备份重要数据
echo.
echo 按任意键返回主菜单...
pause >nul
goto mainMenu
